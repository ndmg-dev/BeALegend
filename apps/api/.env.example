# Owner role — runs Alembic migrations and seeds. Exempt from RLS.
DATABASE_OWNER_URL=postgresql+asyncpg://bealegend:changeme@localhost:5432/bealegend
# Runtime role — subject to Row-Level Security. The API uses only this one.
DATABASE_URL=postgresql+asyncpg://bealegend_app:changeme_app@localhost:5432/bealegend

JWT_SECRET=dev-only-change-me
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=60/minute

CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Caminho do cookie de refresh como o navegador o enxerga (com o prefixo do proxy).
REFRESH_COOKIE_PATH=/api/auth

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Insights de nutrição por IA. Sem NUTRITION_INSIGHTS_ENABLED=true os endpoints
# respondem 204. Sem OPENAI_API_KEY cai no provider fake (texto canned) — em
# produção isso é erro de boot. Ainda exige opt-in por usuário.
NUTRITION_INSIGHTS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
